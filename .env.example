# Copie para ".env" (que está no .gitignore) e troque a senha. NUNCA commite o .env.
# Senha do usuário "sa" do SQL Server do compose: mínimo 8 caracteres, com maiúscula, minúscula e número.
# Use só letras e números para não quebrar a connection string.
MSSQL_SA_PASSWORD=TroqueEstaSenha123

# Mesma senha da linha acima. O servidor "db" é o nome do serviço no docker-compose.yml.
CONNECTION_STRING=Server=db;Database=AgendaPro;User Id=sa;Password=TroqueEstaSenha123;TrustServerCertificate=True

# Origem do front-end liberada no CORS (opcional; padrão http://localhost:4200).
CORS_ORIGIN=http://localhost:4200
